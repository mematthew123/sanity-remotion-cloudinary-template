# Dataset the `video-catalog` Context MCP endpoint serves (same project as the Studio).
CONTEXT_PROJECT_ID=your-project-id
CONTEXT_DATASET=production

# Public site origin, used in endpoint instructions so agents link to real post URLs. Match apps/web's NEXT_PUBLIC_SITE_URL.
# Production: https://renderonce.dev
SITE_URL=http://localhost:3000

# Where agents link template docs (`<DOCS_BASE_URL>/docs/configuration.md`). Point at your fork.
DOCS_BASE_URL=https://github.com/mematthew123/sanity-remotion-cloudinary-template/blob/main
